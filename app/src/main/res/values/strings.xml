    <!-- Login, with a token -->
    <string name="login_token_title">Sign in with token</string>
    <string name="login_token_description">Paste an AniList access token below. This is for those who prefer not to use the browser window, or when the return to the app does not work.</string>
    <string name="login_token_label">Access token</string>
    <string name="login_token_submit">Sign in</string>
    <string name="login_token_steps_title">How to get a token</string>
    <string name="login_token_steps">1. At anilist.co/settings/developer, create an app and set https://anilist.co/api/v2/oauth/pin as its redirect URL.\n2. Open https://anilist.co/api/v2/oauth/authorize?client_id=YOUR_ID&amp;response_type=token and authorize it.\n3. Copy the token shown on the page and paste it here.</string>

    <!-- Login, how it works -->
    <string name="login_info_title">How does your login work?</string>
    <string name="login_info_password_title">Your password stays protected at AniList!</string>
    <string name="login_info_password">Sign-in happens directly on the official AniList website, in a browser window. You type your password there, and Kaisou never has access to it!</string>
    <string name="login_info_access_title">What can Kaisou do?</string>
    <string name="login_info_access">AniList does not split permissions into parts, so the authorization it grants covers almost the whole account. Don\'t worry: Kaisou uses this access only to show and update your lists, your progress and the activity of the people you follow.</string>
    <string name="login_info_storage_title">Where is your access key kept?</string>
    <string name="login_info_storage">It is saved only on this device! Kaisou does not use its own servers, and this data is not included in Android backups.</string>
    <string name="login_info_revoke_title">You are in control!</string>
    <string name="login_info_revoke">Want to disconnect? You can revoke Kaisou\'s access at any time, right from your AniList account settings.</string>

