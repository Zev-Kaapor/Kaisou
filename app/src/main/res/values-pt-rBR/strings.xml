    <!-- Login, com token -->
    <string name="login_token_title">Entrar com token</string>
    <string name="login_token_description">Cole abaixo um token de acesso do AniList. Esse jeito serve para quem prefere não usar a janela do navegador, ou quando o retorno ao app não funciona.</string>
    <string name="login_token_description_browser">A página do AniList abriu no seu navegador. Autorize o Kaisou, copie o token que ela mostra e volte aqui, o Kaisou cola para você. Se não colar, toque em Colar.</string>
    <string name="login_token_paste">Colar</string>
    <string name="login_token_label">Token de acesso</string>
    <string name="login_token_submit">Entrar</string>
    <string name="login_token_steps_title">Como conseguir um token</string>
    <string name="login_token_steps">1. Em anilist.co/settings/developer, crie um aplicativo e use https://anilist.co/api/v2/oauth/pin como URL de redirecionamento.\n2. Abra https://anilist.co/api/v2/oauth/authorize?client_id=SEU_ID&amp;response_type=token e autorize.\n3. Copie o token que aparece na página e cole aqui.</string>

    <!-- Login, como funciona -->
    <string name="login_info_title">Como funciona o seu login?</string>
    <string name="login_info_password_title">Sua senha fica protegida no AniList!</string>
    <string name="login_info_password">O login é feito diretamente no site oficial do AniList, em uma janela do navegador. Você digita a sua senha por lá e o Kaisou nunca tem acesso a ela!</string>
    <string name="login_info_access_title">O que o Kaisou pode fazer?</string>
    <string name="login_info_access">O sistema do AniList não separa as permissões por partes, então a autorização liberada abrange quase toda a conta. Mas fique tranquilo: o Kaisou usa esse acesso apenas para exibir e atualizar as suas listas, o seu progresso e as atividades de quem você segue.</string>
    <string name="login_info_storage_title">Onde fica a sua chave de acesso?</string>
    <string name="login_info_storage">Ela fica salva exclusivamente neste aparelho! O Kaisou não utiliza servidores próprios e esse dado não entra nos backups do Android.</string>
    <string name="login_info_revoke_title">Você está no controle!</string>
    <string name="login_info_revoke" tools:ignore="Typos">Quer desconectar? Você pode revogar o acesso do Kaisou a qualquer momento, direto nas configurações da sua conta no AniList.</string>

