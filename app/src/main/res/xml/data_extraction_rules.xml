<?xml version="1.0" encoding="utf-8"?>
<!-- Rules of the cloud backup and of the device transfer from API 31, see developer.android.com/about/versions/12/backup-restore -->
<data-extraction-rules>
    <cloud-backup>
        <!-- The token of the AniList login stays on the device -->
        <exclude domain="sharedpref" path="kaisou_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="kaisou_session.xml" />
    </device-transfer>
</data-extraction-rules>
